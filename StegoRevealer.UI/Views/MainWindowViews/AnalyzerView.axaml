<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StegoRevealer.UI.ViewModels.MainWindowViewModels"
             mc:Ignorable="d" 
			 d:DesignWidth="1250" d:DesignHeight="650" MinWidth="1250" MinHeight="650"
             x:Class="StegoRevealer.UI.Views.MainWindowViews.AnalyzerView">

	<Design.DataContext>
		<vm:AnalyzerViewModel/>
	</Design.DataContext>

	<!-- Внешняя сетка -->
	<Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
		<!-- Внутренняя сетка -->
		<Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="15"
			  ColumnDefinitions="*,20,*" RowDefinitions="*,80">

			<!-- Левая панель выбора изображения -->
			<StackPanel Orientation="Vertical" HorizontalAlignment="Stretch"
						Grid.Column="0" Grid.Row="0">
				<DockPanel HorizontalAlignment="Stretch" LastChildFill="True">
					<Button Name="LoadImageButton" Content="{Binding L[Common.ChooseImage]}"
							DockPanel.Dock="Left"
							Height="40" Padding="15 0" Margin="0"
							VerticalAlignment="Center" HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
							Click="LoadImageButton_Click"/>
					<TextBox Name="ImagePathLabel" Text="{Binding Path=ImagePath}"
							 DockPanel.Dock="Left" HorizontalContentAlignment="Stretch"
							 Classes="ImagePathTb" IsEnabled="False"
							 HorizontalAlignment="Stretch"
							 ToolTip.Placement="Bottom" ToolTip.ShowOnDisabled="True">
						<ToolTip.Tip>
							<StackPanel>
								<TextBlock FontSize="15" Text="{Binding Path=ImagePath}"/>
							</StackPanel>
						</ToolTip.Tip>
					</TextBox>
				</DockPanel>
				<Image Name="ImagePreview" Source="{Binding Path=DrawedImageSource}"
					   Margin="10"
					   MaxWidth="{Binding Path=ImagePreviewMaxWidth}"
					   MaxHeight="{Binding Path=ImagePreviewMaxHeight}"/>
				<DockPanel HorizontalAlignment="Center" IsVisible="{Binding Path=HasLoadedImage}">
					<TextBox Text="{Binding L[Common.Image.Width]}:"
							 DockPanel.Dock="Left" HorizontalContentAlignment="Stretch"
							 Classes="ImagePathTb" IsEnabled="False"
							 FontStyle="Normal"
							 HorizontalAlignment="Stretch"/>
					<TextBox Name="ImageWidthValue" Text="{Binding Path=CurrentImageWidth}"
							 DockPanel.Dock="Left" HorizontalContentAlignment="Stretch"
							 Classes="ImagePathTb" IsEnabled="False"
							 FontStyle="Normal"
							 HorizontalAlignment="Stretch"/>
					<TextBox Text="{Binding L[Common.Image.Height]}:" Margin="30 0 0 0"
							 DockPanel.Dock="Left" HorizontalContentAlignment="Stretch"
							 Classes="ImagePathTb" IsEnabled="False"
							 FontStyle="Normal"
							 HorizontalAlignment="Stretch"/>
					<TextBox Name="ImageHeightValue" Text="{Binding Path=CurrentImageHeight}"
							 DockPanel.Dock="Left" HorizontalContentAlignment="Stretch"
							 Classes="ImagePathTb" IsEnabled="False"
							 FontStyle="Normal"
							 HorizontalAlignment="Stretch"/>
				</DockPanel>
			</StackPanel>
			<!-- / Левая панель выбора изображения -->

			<!-- Правая панель выбора методов и результатов -->
			<RelativePanel Name="RightPanel"
						   Grid.Column="2" Grid.Row="0"
						   HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
				
				<!-- Экспандер выбора методов -->
				<Expander Name="MethodsExpander" Header="{Binding L[AnalyzerTab.MethodsExpander]}"
						  Classes="RightPanelMethodsExpander"
						  IsExpanded="{Binding Path=IsMethodsOpened}"
						  Expanded="MethodsExpander_Expanded"
						  Collapsed="MethodsExpander_Collapsed"
						  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
						  VerticalContentAlignment="Stretch"
						  RelativePanel.AlignTopWithPanel="True"
						  RelativePanel.AlignRightWithPanel="True"
						  RelativePanel.AlignLeftWithPanel="True"
						  IsEnabled="True">
					<Grid ColumnDefinitions="*" RowDefinitions="50,*">

						<Label Content="{Binding L[AnalyzerTab.UsingMethods]}"
							   FontFamily="Arial" FontWeight="Bold" FontSize="18"
							   Foreground="#FFECECEC"
							   Grid.Column="0" Grid.Row="0"
							   Padding="0" Margin="5"
							   VerticalAlignment="Center" HorizontalAlignment="Center"
							   Background="{x:Null}" BorderBrush="{x:Null}"/>

						<!-- Сетка методов для выбора -->
						<Grid Name="MethodsSelectGrid" IsEnabled="{Binding Path=HasLoadedImage}"
							  Grid.Column="0" Grid.Row="1"
							  Margin="20 10 20 10"
							  ColumnDefinitions="*,100" RowDefinitions="30,30,30,30,30,30,30">

							<CheckBox Name="IsComplexMethodChecked" Content="{Binding L[Methods.ComplexMethod]}"
									  Classes="MethodTurnCheckbox"
									  Grid.Column="0" Grid.Row="0"
									  IsChecked="{Binding Path=ComplexMethodSelected}"
									  ToolTip.Placement="Pointer" ToolTip.ShowOnDisabled="True">
									<ToolTip.Tip>
										<StackPanel>
											<TextBlock FontSize="15" Text="{Binding L[Methods.ComplexMethodTipText]}"/>
										</StackPanel>
									</ToolTip.Tip>
								</CheckBox>
							<CheckBox Name="IsMethodChiSqrChecked" Content="{Binding L[Methods.ChiSqrMethod]}"
									  Classes="MethodTurnCheckbox"
									  Grid.Column="0" Grid.Row="1"
									  IsChecked="{Binding Path=MethodChiSqrSelected}"/>
							<Button Name="MethodChiSqrParamsBtn" Content="{Binding L[Common.Params]}"
									Classes="MethodParametersBtn"
									Grid.Column="1" Grid.Row="1"
									Click="MethodChiSqrParamsBtn_Click"/>
							<CheckBox Name="IsMethodRsChecked" Content="{Binding L[Methods.RsMethod]}"
									  Classes="MethodTurnCheckbox"
									  Grid.Column="0" Grid.Row="2"
									  IsChecked="{Binding Path=MethodRsSelected}"/>
							<Button Name="MethodRsParamsBtn" Content="{Binding L[Common.Params]}"
									Classes="MethodParametersBtn"
									Grid.Column="1" Grid.Row="2"
									Click="MethodRsParamsBtn_Click"/>
							<CheckBox Name="IsMethodSpaChecked" Content="{Binding L[Methods.SpaMethod]}"
									  Classes="MethodTurnCheckbox"
									  Grid.Column="0" Grid.Row="3"
									  IsChecked="{Binding Path=MethodSpaSelected}"/>
							<Button Name="MethodSpaParamsBtn" Content="{Binding L[Common.Params]}"
									Classes="MethodParametersBtn"
									Grid.Column="1" Grid.Row="3"
									Click="MethodSpaParamsBtn_Click"/>
							<CheckBox Name="IsMethodFanChecked" Content="{Binding L[Methods.FanMethod]}"
									  Classes="MethodTurnCheckbox"
									  Grid.Column="0" Grid.Row="4"
									  IsChecked="{Binding Path=MethodFanSelected}"/>
							<Button Name="MethodFanParamsBtn" Content="{Binding L[Common.Params]}"
									Classes="MethodParametersBtn"
									Grid.Column="1" Grid.Row="4"
									Click="MethodFanParamsBtn_Click"/>
							<CheckBox Name="IsMethodZcaChecked" Content="{Binding L[Methods.ZcaMethod]}"
									  Classes="MethodTurnCheckbox"
									  Grid.Column="0" Grid.Row="5"
									  IsChecked="{Binding Path=MethodZcaSelected}"/>
							<Button Name="MethodZcaParamsBtn" Content="{Binding L[Common.Params]}"
									Classes="MethodParametersBtn"
									Grid.Column="1" Grid.Row="5"
									Click="MethodZcaParamsBtn_Click"/>
							<CheckBox Name="IsMethodKzaChecked" Content="{Binding L[Methods.KzhaMethod]}"
									  Classes="MethodTurnCheckbox"
									  Grid.Column="0" Grid.Row="6"
									  IsChecked="{Binding Path=MethodKzhaSelected}"/>
							<Button Name="MethodKzaParamsBtn" Content="{Binding L[Common.Params]}"
									Classes="MethodParametersBtn"
									Grid.Column="1" Grid.Row="6"
									Click="MethodKzaParamsBtn_Click"/>
						</Grid>
						<!-- / Сетка методов для выбора -->
					</Grid>
				</Expander>
				<!-- / Экспандер выбора методов -->

				<Rectangle Name="RightPanelSeparator"
						   HorizontalAlignment="Stretch" Height="1"
						   RelativePanel.AlignRightWithPanel="True"
						   RelativePanel.AlignLeftWithPanel="True"/>

				<!-- Экспандер результатов -->
				<Expander Name="ResultsExpander" Header="{Binding L[AnalyzerTab.ResultsExpander]}"
						  IsExpanded="{Binding Path=!IsMethodsOpened}"
						  Expanded="ResultsExpander_Expanded"
						  Collapsed="ResultsExpander_Collapsed"
						  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
						  VerticalContentAlignment="Stretch"
						  RelativePanel.AlignBottomWithPanel="True"
						  RelativePanel.AlignRightWithPanel="True"
						  RelativePanel.AlignLeftWithPanel="True"
						  IsEnabled="{Binding Path=HasResults}">
					<ScrollViewer>
						<DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
								   LastChildFill="False">
							
							<DockPanel Name="AutoDetectionResultBlock" DockPanel.Dock="Top"
									   LastChildFill="True">
								<TextBlock Name="AutoDetectionResultDesc" Text="{Binding L[AnalyzerTab.Results.ComplexMethodTitle]}: "
										 TextAlignment="Left" Height="25" DockPanel.Dock="Left" Padding="0 0 5 0"
										 HorizontalAlignment="Stretch"/>
								<TextBlock Name="AutoDetectionResultValue" Text="{Binding L[AnalyzerTab.Results.UndefinedResult]}"
										   TextAlignment="Left" Height="25" Margin="10 0 0 0" Padding="10 0 0 0"
										   DockPanel.Dock="Left"/>
							</DockPanel>

							<DockPanel DockPanel.Dock="Top">
								<Grid RowDefinitions="*,*" ColumnDefinitions="4*,*"
									  VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

									<DockPanel Name="ChiFullnessBlock" Grid.Row="0" Grid.Column="0"
									   LastChildFill="True" Margin="0 10 0 0">
										<TextBlock Name="ChiFullnessDesc" Text="{Binding L[AnalyzerTab.Results.CsaMethodTitle]}: "
												 TextAlignment="Left" Height="25" DockPanel.Dock="Left" Padding="0 0 5 0"
												 HorizontalAlignment="Stretch"/>
										<TextBlock Name="ChiFullnessValue" Text="{Binding L[AnalyzerTab.Results.NotAnalyzedResult]}"
												   TextAlignment="Left" Height="25" Margin="20 0 0 0"
												   DockPanel.Dock="Left" ToolTip.Placement="Bottom"/>
									</DockPanel>

									<DockPanel Name="RsFullnessBlock" Grid.Row="1" Grid.Column="0"
											   LastChildFill="True">
										<TextBlock Name="RsFullnessDesc" Text="{Binding L[AnalyzerTab.Results.RsMethodTitle]}: "
												   TextAlignment="Left" Height="25" DockPanel.Dock="Left" Padding="0 0 5 0"
												   HorizontalAlignment="Stretch"/>
										<TextBlock Name="RsFullnessValue" Text="{Binding L[AnalyzerTab.Results.NotAnalyzedResult]}"
												   TextAlignment="Left" Height="25" Margin="20 0 0 0"
												   DockPanel.Dock="Left"/>
									</DockPanel>
									
									<Button Name="JointDesicionOpenBtn" Grid.Column="1" Grid.RowSpan="2" Grid.Row="0"
											HorizontalAlignment="Center" VerticalAlignment="Center"
											HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
											Padding="5 10 5 10" Content="{Binding L[AnalyzerTab.Results.JointDecisionTitle]}" TextBlock.TextWrapping="WrapWithOverflow"
											TextBlock.TextAlignment="Center" IsVisible="False"
											ToolTip.ShowOnDisabled="True" ToolTip.Placement="Pointer"
											Click="JointDesicionOpenBtn_Click">
										<ToolTip.Tip>
											<StackPanel>
												<TextBlock FontSize="15" Text="{Binding L[Methods.JointDecisionMethod]}"/>
											</StackPanel>
										</ToolTip.Tip>
									</Button>

								</Grid>
							</DockPanel>

							<DockPanel Name="SpaFullnessBlock" DockPanel.Dock="Top"
									   LastChildFill="True">
								<TextBlock Name="SpaFullnessDesc" Text="{Binding L[AnalyzerTab.Results.SpaMethodTitle]}: "
										   TextAlignment="Left" Height="25" DockPanel.Dock="Left" Padding="0 0 5 0"
										   HorizontalAlignment="Stretch"/>
								<TextBlock Name="SpaFullnessValue" Text="{Binding L[AnalyzerTab.Results.NotAnalyzedResult]}"
										   TextAlignment="Left" Height="25" Margin="20 0 0 0"
										   DockPanel.Dock="Left"/>
							</DockPanel>

							<DockPanel Name="FanResultBlock" DockPanel.Dock="Top"
									   LastChildFill="True">
								<TextBlock Name="FanResultDesc" Text="{Binding L[AnalyzerTab.Results.FanMethodTitle]}: "
										   TextAlignment="Left" Height="25" DockPanel.Dock="Left" Padding="0 0 5 0"
										   HorizontalAlignment="Stretch"/>
								<TextBlock Name="FanResultValue" Text="{Binding L[AnalyzerTab.Results.NotAnalyzedResult]}"
										   TextAlignment="Left" Height="25" Margin="20 0 0 0"
										   DockPanel.Dock="Left"/>
							</DockPanel>
							
							<DockPanel Name="ZcaResultBlock" DockPanel.Dock="Top"
									   LastChildFill="True">
								<TextBlock Name="ZcaResultDesc" Text="{Binding L[AnalyzerTab.Results.ZcaMethodTitle]}: "
										   TextAlignment="Left" Height="25" DockPanel.Dock="Left" Padding="0 0 5 0"
										   HorizontalAlignment="Stretch"/>
								<TextBlock Name="ZcaResultValue" Text="{Binding L[AnalyzerTab.Results.NotAnalyzedResult]}"
										   TextAlignment="Left" Height="25" Margin="10 0 0 0" Padding="10 0 0 0"
										   DockPanel.Dock="Left"/>
							</DockPanel>
						
							<DockPanel Name="KzhaIntervalFoundedBlock" DockPanel.Dock="Top"
									   LastChildFill="True">
								<TextBlock Name="KzhaIntervalFoundedDesc" Text="{Binding L[AnalyzerTab.Results.KzchaMethod.FoundInterval]}: "
										   TextAlignment="Left" Height="25" DockPanel.Dock="Left" Padding="0 0 5 0"
										   HorizontalAlignment="Stretch"/>
								<TextBlock Name="KzhaIntervalFoundedValue" Text="{Binding L[AnalyzerTab.Results.NotAnalyzedResult]}"
										   TextAlignment="Left" Height="25" Margin="20 0 0 0"
										   DockPanel.Dock="Left"/>
							</DockPanel>
							<DockPanel Name="KzhaBitsNumBlock" DockPanel.Dock="Top" IsVisible="False"
									   LastChildFill="True">
								<TextBlock Name="KzhaBitsNumDesc" Text="{Binding L[AnalyzerTab.Results.KzchaMethod.BitsNum]}: "
										   Padding="30 0 5 0" DockPanel.Dock="Left"
										   HorizontalAlignment="Stretch"
										   TextAlignment="Left" Height="25"/>
								<TextBlock Name="KzhaBitsNumValue" Text="{Binding L[AnalyzerTab.Results.NoData]}"
										   TextAlignment="Left" Height="25" Margin="20 0 0 0"
										   DockPanel.Dock="Left"/>
							</DockPanel>
							<DockPanel Name="KzhaSuspiciousIntervalBlock" DockPanel.Dock="Top" IsVisible="False"
									   LastChildFill="True">
								<TextBlock Name="KzhaSuspiciousIntervalDesc" Text="{Binding L[AnalyzerTab.Results.KzchaMethod.Indexes]}: "
										   Padding="30 0 5 0" DockPanel.Dock="Left"
										   HorizontalAlignment="Stretch"
										   TextAlignment="Left" Height="25"/>
								<TextBlock Name="KzhaSuspiciousIntervalValue" Text="{Binding L[AnalyzerTab.Results.NoData]}"
										   TextAlignment="Left" Height="25" Margin="20 0 0 0"
										   DockPanel.Dock="Left"/>
							</DockPanel>
							<DockPanel Name="KzhaThresholdBlock" DockPanel.Dock="Top" IsVisible="False"
									   LastChildFill="True">
								<TextBlock Name="KzhaThresholdDesc" Text="{Binding L[AnalyzerTab.Results.KzchaMethod.Threshold]}: "
										   Padding="30 0 5 0" DockPanel.Dock="Left"
										   HorizontalAlignment="Stretch"
										   TextAlignment="Left" Height="25"/>
								<TextBlock Name="KzhaThresholdValue" Text="{Binding L[AnalyzerTab.Results.NoData]}"
										   TextAlignment="Left" Height="25" Margin="20 0 0 0"
										   DockPanel.Dock="Left"/>
							</DockPanel>
							<DockPanel Name="KzhaCoeffsBlock" DockPanel.Dock="Top" IsVisible="False"
									   LastChildFill="True">
								<TextBlock Name="KzhaCoeffsDesc" Text="{Binding L[AnalyzerTab.Results.KzchaMethod.Coeffs]}: "
										   Padding="30 0 5 0" DockPanel.Dock="Left"
										   HorizontalAlignment="Stretch"
										   TextAlignment="Left" Height="25"/>
								<TextBlock Name="KzhaCoeffsValue" Text="{Binding L[AnalyzerTab.Results.NoData]}"
										   TextAlignment="Left" Height="25" Margin="20 0 0 0"
										   DockPanel.Dock="Left"/>
							</DockPanel>
							<DockPanel Name="KzhaExtractedDataBlock" DockPanel.Dock="Top" IsVisible="False"
									   LastChildFill="True">
								<TextBlock Name="KzhaExtractedDataLabel" Text="{Binding L[AnalyzerTab.Results.KzchaMethod.ExtractedData]}: "
										   Padding="30 0 5 0" DockPanel.Dock="Left"
										   HorizontalAlignment="Stretch"
										   TextAlignment="Left" Height="25"/>
								<TextBlock Name="KzhaExtractedDataLabelValue" Text="{Binding L[AnalyzerTab.Results.NoHiding]}"
										   TextAlignment="Left" Height="25" Margin="20 0 0 0"
										   DockPanel.Dock="Left"/>
							</DockPanel>
							<TextBox Name="KzhaExtractedDataValue" Text="" DockPanel.Dock="Top"
									 TextAlignment="Left" TextWrapping="Wrap"
									 Height="150" Margin="30 0 15 0"
									 VerticalContentAlignment="Top"
									 IsVisible="False"/>

							<DockPanel Name="StatResultsTitle" DockPanel.Dock="Top"
									   LastChildFill="True" Margin="0 10 0 0">
								<TextBlock Name="StatResultsTitleName" Text="{Binding L[Methods.Stats]}:"
										   TextAlignment="Left" Height="25" DockPanel.Dock="Left" Padding="0 0 5 0"
										   HorizontalAlignment="Stretch"/>
							</DockPanel>
							<DockPanel Name="StatResultsNoise2Block" DockPanel.Dock="Top" IsVisible="True"
									   LastChildFill="True">
								<TextBlock Name="StatResultsNoise2Desc" Text="{Binding L[Stats.Noise]}: "
										   Padding="30 0 5 0" DockPanel.Dock="Left"
										   HorizontalAlignment="Stretch"
										   TextAlignment="Left" Height="25"/>
								<TextBlock Name="StatResultsNoise2Value" Text="{Binding L[AnalyzerTab.Results.NoData]}"
										   TextAlignment="Left" Height="25" Margin="10 0 0 0"
										   DockPanel.Dock="Left"/>
							</DockPanel>
							<DockPanel Name="StatResultsSharpnessBlock" DockPanel.Dock="Top" IsVisible="True"
									   LastChildFill="True">
								<TextBlock Name="StatResultsSharpnessDesc" Text="{Binding L[Stats.Sharpness]}: "
										   Padding="30 0 5 0" DockPanel.Dock="Left"
										   HorizontalAlignment="Stretch"
										   TextAlignment="Left" Height="25"/>
								<TextBlock Name="StatResultsSharpnessValue" Text="{Binding L[AnalyzerTab.Results.NoData]}"
										   TextAlignment="Left" Height="25" Margin="10 0 0 0"
										   DockPanel.Dock="Left"/>
							</DockPanel>
							<DockPanel Name="StatResultsBlurBlock" DockPanel.Dock="Top" IsVisible="True"
									   LastChildFill="True">
								<TextBlock Name="StatResultsBlurDesc" Text="{Binding L[Stats.Blur]}: "
										   Padding="30 0 5 0" DockPanel.Dock="Left"
										   HorizontalAlignment="Stretch"
										   TextAlignment="Left" Height="25"/>
								<TextBlock Name="StatResultsBlurValue" Text="{Binding L[AnalyzerTab.Results.NoData]}"
										   TextAlignment="Left" Height="25" Margin="10 0 0 0"
										   DockPanel.Dock="Left"/>
							</DockPanel>
							<DockPanel Name="StatResultsContrastBlock" DockPanel.Dock="Top" IsVisible="True"
									   LastChildFill="True">
								<TextBlock Name="StatResultsContrastDesc" Text="{Binding L[Stats.Contrast]}: "
										   Padding="30 0 5 0" DockPanel.Dock="Left"
										   HorizontalAlignment="Stretch"
										   TextAlignment="Left" Height="25"/>
								<TextBlock Name="StatResultsContrastValue" Text="{Binding L[AnalyzerTab.Results.NoData]}"
										   TextAlignment="Left" Height="25" Margin="10 0 0 0"
										   DockPanel.Dock="Left"/>
							</DockPanel>
							<!--<DockPanel Name="StatResultsEntropyTsallisBlock" DockPanel.Dock="Top" IsVisible="True"
									   LastChildFill="True">
								<TextBlock Text="{Binding L[Stats.Entropy.Tsallis]}: "
										   Padding="30 0 0 0" DockPanel.Dock="Left"
										   HorizontalAlignment="Stretch"
										   TextAlignment="Left" Height="25"/>
								<TextBlock Name="StatResultsEntropyTsallisValue" Text="{Binding L[AnalyzerTab.Results.NoData]}"
										   TextAlignment="Left" Height="25" Margin="10 0 0 0"
										   DockPanel.Dock="Left"/>
							</DockPanel>
							<DockPanel Name="StatResultsEntropyVaidaBlock" DockPanel.Dock="Top" IsVisible="True"
									   LastChildFill="True">
								<TextBlock Text="{Binding L[Stats.Entropy.Vaida]}: "
										   Padding="30 0 0 0" DockPanel.Dock="Left"
										   HorizontalAlignment="Stretch"
										   TextAlignment="Left" Height="25"/>
								<TextBlock Name="StatResultsEntropyVaidaValue" Text="{Binding L[AnalyzerTab.Results.NoData]}"
										   TextAlignment="Left" Height="25" Margin="10 0 0 0"
										   DockPanel.Dock="Left"/>
							</DockPanel>-->
							<DockPanel Name="StatResultsEntropyShennonBlock" DockPanel.Dock="Top" IsVisible="True"
									   LastChildFill="True">
								<TextBlock Name="StatResultsEntropyShennonDesc" Text="{Binding L[Stats.Entropy.Shennon]}: "
										   Padding="30 0 5 0" DockPanel.Dock="Left"
										   HorizontalAlignment="Stretch"
										   TextAlignment="Left" Height="25"/>
								<TextBlock Name="StatResultsEntropyShennonValue" Text="{Binding L[AnalyzerTab.Results.NoData]}"
										   TextAlignment="Left" Height="25" Margin="10 0 0 0"
										   DockPanel.Dock="Left"/>
							</DockPanel>
							<DockPanel Name="StatResultsEntropyRenyiBlock" DockPanel.Dock="Top" IsVisible="True"
									   LastChildFill="True">
								<TextBlock Name="StatResultsEntropyRenyiDesc" Text="{Binding L[Stats.Entropy.Renyi]} (α = 1,1): "
										   Padding="30 0 5 0" DockPanel.Dock="Left"
										   HorizontalAlignment="Stretch"
										   TextAlignment="Left" Height="25"/>
								<TextBlock Name="StatResultsEntropyRenyiValue" Text="{Binding L[AnalyzerTab.Results.NoData]}"
										   TextAlignment="Left" Height="25" Margin="10 0 0 0"
										   DockPanel.Dock="Left"/>
							</DockPanel>
							<!--<DockPanel Name="StatResultsEntropyHavardBlock" DockPanel.Dock="Top" IsVisible="True"
									   LastChildFill="True">
								<TextBlock Text="{Binding L[Stats.Entropy.Havard]}: "
										   Padding="30 0 0 0" DockPanel.Dock="Left"
										   HorizontalAlignment="Stretch"
										   TextAlignment="Left" Height="25"/>
								<TextBlock Name="StatResultsEntropyHavardValue" Text="{Binding L[AnalyzerTab.Results.NoData]}"
										   TextAlignment="Left" Height="25" Margin="10 0 0 0"
										   DockPanel.Dock="Left"/>
							</DockPanel>-->

							<DockPanel Name="ElapsedTimeBlock" DockPanel.Dock="Bottom"
									   LastChildFill="True">
								<TextBlock Name="ElapsedTimeLabel" Text="{Binding L[Common.ElapseTime]}: "
										   FontStyle="Italic" Padding="0 0 5 0" VerticalAlignment="Center"
										   HorizontalAlignment="Stretch" DockPanel.Dock="Left"
										   TextAlignment="Left" Height="25"/>
								<TextBlock Name="ElapsedTimeValue" Text="0 мс"
										   FontStyle="Italic" VerticalAlignment="Center"
										   TextAlignment="Left" Height="25" Margin="20 0 0 0"
										   DockPanel.Dock="Left"/>
								<StackPanel Name="ResultsHandlerBlock" DockPanel.Dock="Left" Orientation="Horizontal" 
											VerticalAlignment="Center" HorizontalAlignment="Right">
									<Button Name="CopyAsTextBtn" Click="CopyAsTextBtn_Click">
										<PathIcon Data="{StaticResource IconCopyText}"/>
										<ToolTip.Tip>
											<StackPanel>
												<TextBlock FontSize="15" Text="{Binding L[AnalyzerTab.Results.CopyResults]}"/>
											</StackPanel>
										</ToolTip.Tip>
									</Button>
									<Button Name="CopyAsJsonBtn" Click="CopyAsJsonBtn_Click">
										<PathIcon Data="{StaticResource IconCopyJson}"/>
										<ToolTip.Tip>
											<StackPanel>
												<TextBlock FontSize="15" Text="{Binding L[AnalyzerTab.Results.CopyResults]} (raw JSON)"/>
											</StackPanel>
										</ToolTip.Tip>
									</Button>
								</StackPanel>
							</DockPanel>
						
						</DockPanel>
					</ScrollViewer>
				</Expander>
				<!-- / Экспандер результатов -->
			</RelativePanel>
			<!-- / Правая панель выбора методов и результатов -->

			<Button Name="StartAnalysis" Content="{Binding L[Common.Start]}"
					FontSize="24" FontWeight="Bold"
					Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3"
					MinHeight="50" Padding="100 15" Margin="0 15 0 0"
					HorizontalAlignment="Center"
					HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
					Click="StartAnalysis_Click" IsEnabled="{Binding Path=HasLoadedImage}"/>
		</Grid>
		<!-- / Внутренняя сетка -->

		<!-- Оверлей с анимацией загрузки -->
		<Border Name="LoadingOverlay" IsVisible="False" ZIndex="1000"
				HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
			<Grid>
				<ProgressBar IsIndeterminate="True" Width="400" Height="40"
							 Background="{StaticResource ResourceKey=SrDarkLight}" Foreground="{StaticResource ResourceKey=SrDark}"
							 BorderBrush="#000000" BorderThickness="1"
							 HorizontalAlignment="Center" VerticalAlignment="Center"/>
			</Grid>
		</Border>
	</Grid>
	<!-- / Внешняя сетка -->
	
</UserControl>
