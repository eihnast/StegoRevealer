<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StegoRevealer.UI.ViewModels.AdditionalInfoWindowViewModels"
			 xmlns:cmp="clr-namespace:StegoRevealer.UI.Components"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="900" MinWidth="1280" MinHeight="900"
             x:Class="StegoRevealer.UI.Views.AdditionalInfoWindowViews.JointDecisionInfoView">

	<Design.DataContext>
		<vm:JointDecisionInfoViewModel/>
	</Design.DataContext>

	<Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
		<Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
			  ColumnDefinitions="*" RowDefinitions="40,700,50"
			  Margin="20 10 20 10">

			<Label Name="TitleLabel" Content="{Binding L[Methods.JointDecisionMethod]}"
				   Foreground="#FFE0E0E0" FontWeight="Bold" FontSize="16"
				   Grid.Column="0" Grid.Row="0"
                   Background="{x:Null}" BorderBrush="{x:Null}"
                   VerticalAlignment="Center" VerticalContentAlignment="Center"
				   HorizontalAlignment="Center" HorizontalContentAlignment="Center"
				   Padding="0"/>

			<StackPanel Grid.Column="0" Grid.Row="1" Margin="0 0 0 0" Height="700"
						Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
				<cmp:RsCsaGraph Name="RsCsaGraphFull" Width="700" Height="700"/>
				<DockPanel Width="400" Height="700" Margin="10 0 0 0" LastChildFill="True" VerticalAlignment="Top">
					<Label Content="{Binding L[JointAnalysis.O1SectorTitle]}" Foreground="#FFE0E0E0" FontWeight="Bold" FontSize="14"
						   HorizontalAlignment="Center" VerticalAlignment="Top" DockPanel.Dock="Top"/>
					<cmp:RsCsaO1Graph Name="RsCsaGraphO1" Width="300" Height="300" VerticalAlignment="Top" DockPanel.Dock="Top"/>
					<Label Content="{Binding L[JointAnalysis.SectorsDescription], StringFormat='{}{0}:'}" Foreground="#FFE0E0E0" FontSize="14" Margin="0 5 0 0"
						   HorizontalAlignment="Left" VerticalAlignment="Top" DockPanel.Dock="Top" TextBlock.TextWrapping="Wrap"/>
					<Label Content="{Binding L[JointAnalysis.EmptyContainer], StringFormat='{}O.1 - {0}'}" Foreground="#FFE0E0E0" FontSize="14" Margin="0 0 0 0"
						   HorizontalAlignment="Left" VerticalAlignment="Top" DockPanel.Dock="Top" TextBlock.TextWrapping="Wrap"/>
					<Label Foreground="#FFE0E0E0" FontSize="14" Margin="0 0 0 0"
						   HorizontalAlignment="Left" VerticalAlignment="Top" DockPanel.Dock="Top" TextBlock.TextWrapping="Wrap">
						<Label.Content>
							<MultiBinding StringFormat="O.2 - p ≈ {0}, {1}">
								<Binding Path="L[JointAnalysis.RsEstimation]" />
								<Binding Path="L[JointAnalysis.RandomHiding]" />
							</MultiBinding>
						</Label.Content>
					</Label>
					<Label Foreground="#FFE0E0E0" FontSize="14" Margin="0 0 0 0"
						   HorizontalAlignment="Left" VerticalAlignment="Top" DockPanel.Dock="Top" TextBlock.TextWrapping="Wrap">
						<Label.Content>
							<MultiBinding StringFormat="O.3 - p ≈ {0}, {1}">
								<Binding Path="L[JointAnalysis.CsaEstimation]" />
								<Binding Path="L[JointAnalysis.LinearHiding]" />
							</MultiBinding>
						</Label.Content>
					</Label>
					<Label Foreground="#FFE0E0E0" FontSize="14" Margin="0 0 0 0"
						   HorizontalAlignment="Left" VerticalAlignment="Top" DockPanel.Dock="Top" TextBlock.TextWrapping="Wrap">
						<Label.Content>
							<MultiBinding StringFormat="O.4 - p ≈ {0}, {1}">
								<Binding Path="L[JointAnalysis.RsEstimation]" />
								<Binding Path="L[JointAnalysis.RandomHiding]" />
							</MultiBinding>
						</Label.Content>
					</Label>
					<Label Content="{Binding L[JointAnalysis.RandomHiding], StringFormat='{}O.5 - p > 80%, {0}'}" Foreground="#FFE0E0E0" FontSize="14" Margin="0 0 0 0"
						   HorizontalAlignment="Left" VerticalAlignment="Top" DockPanel.Dock="Top" TextBlock.TextWrapping="Wrap"/>
					<Label Content="{Binding L[JointAnalysis.LinearHiding], StringFormat='{}O.6 - p ≈ 100%, {0}'}" Foreground="#FFE0E0E0" FontSize="14" Margin="0 0 0 0"
						   HorizontalAlignment="Left" VerticalAlignment="Top" DockPanel.Dock="Top" TextBlock.TextWrapping="Wrap"/>
					<Label Content="{Binding L[JointAnalysis.RandomHiding], StringFormat='{}O.7 - p ≈ 100%, {0}'}" Foreground="#FFE0E0E0" FontSize="14" Margin="0 0 0 0"
						   HorizontalAlignment="Left" VerticalAlignment="Top" DockPanel.Dock="Top" TextBlock.TextWrapping="Wrap"/>
				</DockPanel>
			</StackPanel>

			<StackPanel Grid.Column="0" Grid.Row="2" Margin="0 0 0 0"
						Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top">
				<Label Content="{Binding L[JointAnalysis.ResultTitle], StringFormat='{}{0}:'}"
					   Foreground="#FFE0E0E0" FontSize="14"
					   Background="{x:Null}" BorderBrush="{x:Null}" TextBlock.TextWrapping="Wrap"
					   VerticalAlignment="Top" VerticalContentAlignment="Top"
					   HorizontalAlignment="Center" HorizontalContentAlignment="Center"
					   Padding="0"/>
				<Label Name="ResultLabel" Content=""
					   Foreground="#FFE0E0E0" FontWeight="Bold" FontSize="18" Margin="0 15 0 0"
					   Background="{x:Null}" BorderBrush="{x:Null}" TextBlock.TextWrapping="Wrap"
					   VerticalAlignment="Top" VerticalContentAlignment="Top"
					   HorizontalAlignment="Center" HorizontalContentAlignment="Center"
					   Padding="0"/>
			</StackPanel>

		</Grid>
	</Grid>

</UserControl>
