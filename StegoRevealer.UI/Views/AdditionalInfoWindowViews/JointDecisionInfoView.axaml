<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StegoRevealer.UI.ViewModels.AdditionalInfoWindowViewModels"
			 xmlns:cmp="clr-namespace:StegoRevealer.UI.Components"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="900" MinWidth="1280" MinHeight="900"
             x:Class="StegoRevealer.UI.Views.AdditionalInfoWindowViews.JointDecisionInfoView">

	<Design.DataContext>
		<vm:JointDecisionInfoViewModel/>
	</Design.DataContext>

	<Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
		<Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
			  ColumnDefinitions="*" RowDefinitions="40,*"
			  Margin="20 10 20 10">

			<Label Name="TitleLabel" Content="Методика формирования вывода при совместном применении методов CSA и RS"
				   Foreground="#FFE0E0E0" FontWeight="Bold" FontSize="16"
				   Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                   Background="{x:Null}" BorderBrush="{x:Null}"
                   VerticalAlignment="Center" VerticalContentAlignment="Center"
				   HorizontalAlignment="Center" HorizontalContentAlignment="Center"
				   Padding="0"/>

			<StackPanel Grid.Column="0" Grid.Row="1" Margin="0 0 0 0"
						Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
				<cmp:RsCsaGraph Width="700" Height="700"/>
				<DockPanel Width="400" Height="700" Margin="10 0 0 0" LastChildFill="True" VerticalAlignment="Top">
					<Label Content="Сектор O.1" Foreground="#FFE0E0E0" FontWeight="Bold" FontSize="14"
						   HorizontalAlignment="Center" VerticalAlignment="Top" DockPanel.Dock="Top"/>
					<cmp:RsCsaO1Graph Width="300" Height="300" VerticalAlignment="Top" DockPanel.Dock="Top"/>
					<Label Content="Описание секторов:" Foreground="#FFE0E0E0" FontSize="14" Margin="0 5 0 0"
						   HorizontalAlignment="Left" VerticalAlignment="Top" DockPanel.Dock="Top" TextBlock.TextWrapping="Wrap"/>
					<Label Content="О.1 - Пустой контейнер" Foreground="#FFE0E0E0" FontSize="14" Margin="0 0 0 0"
						   HorizontalAlignment="Left" VerticalAlignment="Top" DockPanel.Dock="Top" TextBlock.TextWrapping="Wrap"/>
					<Label Content="О.2 - p ≈ оценка по RS, псевдослучайное встраивание" Foreground="#FFE0E0E0" FontSize="14" Margin="0 0 0 0"
						   HorizontalAlignment="Left" VerticalAlignment="Top" DockPanel.Dock="Top" TextBlock.TextWrapping="Wrap"/>
					<Label Content="О.3 - p ≈ оценка по CSA, последовательное встраивание" Foreground="#FFE0E0E0" FontSize="14" Margin="0 0 0 0"
						   HorizontalAlignment="Left" VerticalAlignment="Top" DockPanel.Dock="Top" TextBlock.TextWrapping="Wrap"/>
					<Label Content="О.4 - p ≈ оценка по RS, псевдослучайное встраивание" Foreground="#FFE0E0E0" FontSize="14" Margin="0 0 0 0"
						   HorizontalAlignment="Left" VerticalAlignment="Top" DockPanel.Dock="Top" TextBlock.TextWrapping="Wrap"/>
					<Label Content="О.5 - p > 80%, псевдослучайное встраивание" Foreground="#FFE0E0E0" FontSize="14" Margin="0 0 0 0"
						   HorizontalAlignment="Left" VerticalAlignment="Top" DockPanel.Dock="Top" TextBlock.TextWrapping="Wrap"/>
					<Label Content="О.6 - p ≈ 100%, последовательное встраивание" Foreground="#FFE0E0E0" FontSize="14" Margin="0 0 0 0"
						   HorizontalAlignment="Left" VerticalAlignment="Top" DockPanel.Dock="Top" TextBlock.TextWrapping="Wrap"/>
					<Label Content="О.7 - p ≈ 100%, псевдослучайное встраивание" Foreground="#FFE0E0E0" FontSize="14" Margin="0 0 0 0"
						   HorizontalAlignment="Left" VerticalAlignment="Top" DockPanel.Dock="Top" TextBlock.TextWrapping="Wrap"/>
				</DockPanel>
			</StackPanel>

		</Grid>
	</Grid>

</UserControl>
