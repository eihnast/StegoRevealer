<Project>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Math -->
    <PackageVersion Include="Accord.Math" Version="3.8.0" />
    <PackageVersion Include="Accord.Statistics" Version="3.8.0" />
    <PackageVersion Include="DynamicData" Version="9.4.33" />
    <PackageVersion Include="MathNet.Numerics" Version="5.0.0" />
    <!-- ML -->
    <PackageVersion Include="Microsoft.ML" Version="5.0.0" />
    <PackageVersion Include="Microsoft.ML.FastTree" Version="5.0.0" />
    <PackageVersion Include="Microsoft.ML.LightGbm" Version="5.0.0" />
    <!-- Avalonia -->
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageVersion Include="ReactiveUI.Avalonia" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.22" />
    <!-- Test -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.4.1" />
    <!-- SkiaSharp -->
    <PackageVersion Include="SkiaSharp" Version="4.153.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.153.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="4.153.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.macOS" Version="4.153.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.153.0" />
    <!-- Other -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="MessagePack" Version="3.1.10" />
    <PackageVersion Include="SharpCompress" Version="0.50.4" />
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
    <PackageVersion Include="Plotly.NET" Version="5.1.0" />
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <PackageVersion Include="coverlet.msbuild" Version="10.1.0" />
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>
</Project>